{
  "expo": {
    "name": "Salon POS Pro",
    "slug": "salon-pos-pro",
    "scheme": "salonpos",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salonpos.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Dibutuhkan untuk menghubungkan printer thermal via Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Dibutuhkan untuk mencetak struk via printer Bluetooth."
      }
    },
    "android": {
      "package": "com.salonpos.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7EBD3"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7EBD3"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b04a7ad1-0930-47e8-9912-5e5261930e48"
      }
    },
    "owner": "mldyzhrn",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/b04a7ad1-0930-47e8-9912-5e5261930e48" }
  }
}
